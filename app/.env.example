# v0.7.75 PRIORITY EXIT — PAPER ONLY
# Default deliberately avoids PumpPortal paid trade subscriptions.
TRADE_DATA_PROVIDER=pumpapi
PUMPPORTAL_API_KEY=
BITQUERY_TOKEN=
DATABASE_PATH=data/clean_0762.db
DASHBOARD_PORT=8188
START_BALANCE=30
POSITION_SIZE=3
MAX_POSITIONS=2

MIN_TRADES_FOR_ENTRY=4
MIN_UNIQUE_BUYERS=3
MIN_BUY_SELL_RATIO=1.35
MIN_MOMENTUM_PCT=2.0
MIN_SCORE=70
MAX_ENTRY_MOMENTUM_PCT=18.0
MAX_ENTRY_LAST_JUMP_PCT=10.0
MIN_ENTRY_AGE_SECONDS=1.5
STOP_LOSS_PCT=-0.12
TP1_PCT=0.15
TP2_PCT=0.30
TRAILING_STOP_PCT=0.08
MAX_HOLD_SECONDS=120
CANDIDATE_TTL_SECONDS=180
ALLOW_REENTRY=false
MAX_ACTIVE_SUBSCRIPTIONS=24
STREAM_STALE_SECONDS=20
PASS_PIN_SECONDS=90
MAX_CANDIDATES=750
MAX_BUYERS_PER_MINT=64
WS_MAX_QUEUE=256
SUB_QUEUE_MAX=512
MEMORY_SOFT_LIMIT_MB=350
MEMORY_HARD_LIMIT_MB=600
HISTORY_SET_MAX=10000

PROBATION_MIN_SECONDS=8
PROBATION_MAX_SECONDS=20
EARLY_FAIL_MAX_MFE_PCT=2.5
EARLY_FAIL_RETURN_PCT=-3.0
EARLY_FAIL_HARD_RETURN_PCT=-6.0
EARLY_FAIL_HARD_MAX_MFE_PCT=1.5
EARLY_FAIL_MIN_POST_TRADES=3
EARLY_FAIL_MAX_POST_BUY_SELL_RATIO=1.0
RECONNECT_BACKOFF_MAX_SECONDS=30
RECONNECT_JITTER_MAX_SECONDS=0.75
FAST_PROTECT_SECONDS=12
FAST_STOP_PCT=-8.0
FAST_STOP_MIN_EVENTS=1

# Cost protection: if PumpPortal is explicitly selected and rejects funding,
# stop the retry loop instead of repeatedly reconnecting/subscribing.
PUMPPORTAL_FAIL_FAST=true
PUMPPORTAL_BLOCK_COOLDOWN_SECONDS=3600
RECORD_DISCOVERY=true

# Free feed: no PumpPortal API key and no SOL funding required.
FREE_API_BASE=https://frontend-api.pump.fun
FREE_API_POLL_SECONDS=1.25
FREE_API_MAX_MINTS=12
FREE_API_LIMIT=20
FREE_API_TIMEOUT_SECONDS=6

# Free websocket data feed (no API key)
PUMPAPI_STREAM_URL=wss://stream.pumpapi.io/
PUMPAPI_POOL=pump

# v0.4.8.8.3 stream stability: 0 disables client websocket keepalive pings.
PUMPAPI_PING_INTERVAL_SECONDS=0
PUMPAPI_OPEN_TIMEOUT_SECONDS=12
PUMPAPI_CLOSE_TIMEOUT_SECONDS=2
PUMPAPI_MIN_RECONNECT_DELAY_SECONDS=8

# v0.4.8.8.5 gap-aware transport
DATA_GAP_MARK_SECONDS=5
DATA_GAP_EXIT_SECONDS=12

# ENTRY QUALITY V2
ENTRY_QUALITY_V2=true
EQ_MAX_PULLBACK_PCT=5.0
EQ_MIN_RECENT_SLOPE_PCT=-1.5
EQ_MIN_BUY_PRESSURE_TREND=0.55
EQ_MIN_SAMPLES=4

# PROFIT PROTECTION V1 — entry/transport/TP2 settings unchanged
PROFIT_PROTECTION_V1=false
PP_SHADOW_V2=false
PP_SHADOW_MIN_LOCK_PCT=1.0
PP_ACTIVATE_MFE_PCT=6.0
PP_MAX_GIVEBACK_PCT=7.0
PP_MIN_LOCK_PCT=1.0
PP_MIN_AGE_SECONDS=8
PP_SHADOW_MAX_SECONDS=180

# CPU HOTFIX
SHADOW_CHECK_INTERVAL_SECONDS=0.25
CLEANUP_INTERVAL_SECONDS=0.50
CPU_SHADOW_PAUSE_PCT=85
CPU_SHADOW_RESUME_PCT=65
EVENT_LOOP_LAG_PAUSE_MS=250

# PERFORMANCE FIX: raw tick persistence is off by default; counters/strategy remain active.
RECORD_RAW_EVENTS=false
# PP engine diagnostic is enabled in .7.4.3. Real exits remain unchanged.
# PP_SHADOW_V2 is defined once above and must remain true for this build.

# v0.4.9.4 transport hardening
PUMPAPI_SINGLETON_PORT=49190
PUMPAPI_SERVER_SINGLE_WS_COOLDOWN_SECONDS=240
PUMPAPI_CLOSE_GRACE_SECONDS=15
PUMPAPI_STALL_SECONDS=20
PUMPAPI_WATCHDOG_RECONNECT_DELAY_SECONDS=2
BLOCK_ENTRIES_WHEN_TRADE_STALLED=true

# v0.6 configurable execution-stress assumptions (not live provider quotes)
EXECUTION_SIM_ENABLED=true
SIM_BUY_SLIPPAGE_PCT=1.0
SIM_SELL_SLIPPAGE_PCT=1.5
SIM_TRADE_FEE_PCT=1.0
SIM_PRIORITY_FEE_USD=0.005
SIM_BASE_LATENCY_MS=450
SIM_LATENCY_JITTER_MS=550
SIM_FAILED_TX_PROB=0.02
SIM_FAILED_EXIT_EXTRA_SLIPPAGE_PCT=3.0

# v0.6.1 audit profiles are defined in config.py; these are diagnostic assumptions only.
EXEC_AUDIT_ENABLED=true

# v0.6.2 transport hardening: soft stale blocks entries; hard stall rebuilds socket.
PUMPAPI_STALL_SECONDS=20
PUMPAPI_HARD_STALL_SECONDS=60
PUMPAPI_WATCHDOG_TICK_SECONDS=5
PUMPAPI_WATCHDOG_RECONNECT_DELAY_SECONDS=8
PUMPAPI_CLOSE_GRACE_SECONDS=15
PUMPAPI_SERVER_SINGLE_WS_COOLDOWN_SECONDS=240

# v0.6.4 diagnostic only
EDGE_LAB_ENABLED=true

# v0.6.4 trajectory lab (shadow only)
TRAJECTORY_LAB_ENABLED=true

CLASSIFIER_LAB_ENABLED=true

SWEET_SPOT_LAB_ENABLED=true

OFFLINE_MODEL_LAB_ENABLED=true

# v0.6.8 walk-forward validation
WALK_FORWARD_ENABLED=true
WALK_FORWARD_MIN_TRAIN=300
WALK_FORWARD_TEST_SIZE=100
WALK_FORWARD_STEP=100
WALK_FORWARD_MIN_TEST_REMAINDER=50

# v0.6.9 model-gated paper
MODEL_GATE_ENABLED=true
MODEL_GATE_THRESHOLD=0.55
MODEL_GATE_MIN_TRAIN=300
MODEL_GATE_RETRAIN_EVERY=25
TRUE_SHADOW_AB_ENABLED=true
MODEL_GATE_FREEZE_AFTER_WARMUP=true
# v0.6.9.6 FINAL VALIDATION: keep threshold/model frozen during this run.

# v0.6.9.6 frozen validation gate
MODEL_GATE_ENABLED=false

# v0.7.1 frozen independent SWEET-65 validation
MODEL_GATE_ENABLED=false
TRUE_SHADOW_AB_ENABLED=true

MICRO_CONFIRM_LAB_ENABLED=false
MICRO_CONFIRM_MIN_RETURN_PCT=0.0
MICRO_CONFIRM_MIN_BUY_PRESSURE=0.55
DISCOVERY_STALE_SECONDS=180

# v0.7.5 frozen independent gate
LAST1_GATE_ENABLED=true
LAST1_GATE_MIN_RETURN_PCT=2.0
LAST1_GATE_TARGET_BE_PER_TRADE=0.20

# v0.7.9 frozen control + v0.7.10 RECOVERY RISK CONTROL — shadow-only
# These are mirrored in config.py and intentionally frozen for this research run.
FAST_RECOVERY_SIGNAL_ENABLED=true
FAST_RECOVERY_SIGNAL_MAX_SECONDS=30
FAST_RECOVERY_SIGNAL_TARGET_SAMPLES=300
FAST_RECOVERY_SIGNAL_MIN_AGE=1.0
FAST_RECOVERY_SIGNAL_HARD_ABORT_PCT=-6.0
FAST_RECOVERY_SIGNAL_ARM_PCT=5.0
FAST_RECOVERY_SIGNAL_ARM_MOMENTUM_PCT=0.5
FAST_RECOVERY_SIGNAL_MIN_BUY_PRESSURE=0.55
FAST_RECOVERY_SIGNAL_TRAIL_PCT=3.0
FAST_RECOVERY_SIGNAL_LOCK_PCT=1.0
FAST_RECOVERY_SIGNAL_MOMENTUM_FADE_PCT=-1.0
FAST_RECOVERY_SIGNAL_PRESSURE_FADE=0.40
FAST_RECOVERY_SIGNAL_NO_RECOVERY_SECONDS=8.0
FAST_RECOVERY_SIGNAL_NO_RECOVERY_PEAK_PCT=3.0
FAST_RECOVERY_SIGNAL_FRESH_SECONDS=5.0

# v0.7.10 pre-arm risk layer (frozen for this validation)
FAST_RECOVERY_RISK_ENABLED=false
FAST_RECOVERY_RISK_TARGET_SAMPLES=300
FAST_RECOVERY_RISK_EARLY_MIN_AGE=1.5
FAST_RECOVERY_RISK_EARLY_MIN_EVENTS=3
FAST_RECOVERY_RISK_COLLAPSE_PCT=-3.5
FAST_RECOVERY_RISK_COLLAPSE_MOM_PCT=-2.0
FAST_RECOVERY_RISK_COLLAPSE_MAX_BUY_PRESSURE=0.40
FAST_RECOVERY_RISK_NO_BOUNCE_AGE=3.0
FAST_RECOVERY_RISK_NO_BOUNCE_MIN_EVENTS=4
FAST_RECOVERY_RISK_NO_BOUNCE_PEAK_PCT=1.5
FAST_RECOVERY_RISK_NO_BOUNCE_LOSS_PCT=-2.0
FAST_RECOVERY_RISK_NO_BOUNCE_MOM_PCT=-1.0
FAST_RECOVERY_RISK_NO_BOUNCE_MAX_BUY_PRESSURE=0.40
FAST_RECOVERY_RISK_MIN_BASE_DELTA_PER_FAST=0.05
FAST_RECOVERY_RISK_MAX_BIG_WORSE_RATE=0.10

# v0.7.12 FALSE-BOUNCE CLASSIFIER LAB — SHADOW ONLY
FAST_REENTRY_ENABLED=true
FAST_REENTRY_TARGET_FAST=300
FAST_REENTRY_MIN_REENTRIES=80
FAST_REENTRY_WATCH_SECONDS=30
FAST_REENTRY_MIN_AGE=1.0
FAST_REENTRY_MIN_EVENTS=3
FAST_REENTRY_TRIGGER_RECOVERY_PCT=5.0
FAST_REENTRY_TRIGGER_MOMENTUM_PCT=0.5
FAST_REENTRY_MIN_BUY_PRESSURE=0.55
FAST_REENTRY_MAX_HOLD_SECONDS=20
FAST_REENTRY_HARD_STOP_PCT=-5.0
FAST_REENTRY_TRAIL_ARM_PCT=5.0
FAST_REENTRY_TRAIL_PCT=3.0
FAST_REENTRY_LOCK_PCT=1.0
FAST_REENTRY_FADE_MIN_AGE=2.0
FAST_REENTRY_FADE_MOMENTUM_PCT=-1.0
FAST_REENTRY_FADE_MAX_BUY_PRESSURE=0.40
FAST_REENTRY_FRESH_SECONDS=5.0
FAST_REENTRY_BIG_LOSS_USD=0.30
FAST_REENTRY_MIN_BASE_LIFT_PER_FAST=0.05
FAST_REENTRY_MAX_BIG_LOSS_RATE=0.10

# Use 02_SETTINGS.bat before running v0.7.52. API key is not a wallet key.
JUPITER_API_KEY=
QUOTE_RPC_URL=https://api.mainnet-beta.solana.com
# Experimental price floor: 10% below the original exit signal, minimum quoted proceeds.
QUOTE_MAX_LOSS_BPS=1000
# Provider quote slippage tolerance: 1%.
QUOTE_SLIPPAGE_BPS=100

# Optional public address ONLY. Leave empty for reserve checks.
SIMULATION_PUBLIC_KEY=

# v0.7.52: execution adapter is isolated from the main PAPER strategy.
EXECUTION_MODE=paper

# Read-only 12_NETWORK_CHECK only. Does not enable scanner failover.
NETWORK_CHECK_BACKUP_RPC_URL=

# v0.7.89 common PAPER RPC admission (keep fixed during the test).
RPC_MAX_REQUESTS_PER_SECOND=6
RPC_MAX_INFLIGHT=4
RPC_ADMISSION_WAIT_SECONDS=0.75
